#include <windows.h>
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "LiDE50 Scan (open source)"
      VALUE "FileDescription", "LiDE50 Scan - portable scanner app for Canon CanoScan LiDE 50"
      VALUE "FileVersion", "1.3.0"
      VALUE "ProductName", "LiDE50 Scan"
      VALUE "ProductVersion", "1.3.0"
      VALUE "LegalCopyright", "GPL-2.0-or-later. Includes SANE genesys, libusb, miniz, stb."
      VALUE "OriginalFilename", "LiDE50Scan.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
